type Query {
  posts(page: Int = 1, limit: Int = 10, sortBy: String = "createdAt", order: SortOrder = DESC, q: String): PostPage!
  users(limit: Int = 50): [User!]!
}

enum SortOrder { ASC DESC }

type PostPage {
  content: [Post!]!
  page: Int!
  totalPages: Int!
  totalElements: Int!
}

type User {
  id: ID!
  username: String!
  displayName: String!
  createdAt: String!
  posts(limit: Int = 10): [Post!]!
}

type Post {
  id: ID!
  title: String!
  content: String
  createdAt: String!
  author: User!
}


